# Copy to apps/api/.env for local development. Never commit the filled-in version.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Neon. Use a BRANCH connection string locally, never the production one.
DATABASE_URL=postgresql://user:password@ep-example.us-east-1.aws.neon.tech/fantasyguru?sslmode=require

# Gate 1 on /internal/*. Minimum 16 chars; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_SECRET=

# Gate 2 on /internal/*. From the Upstash QStash console. Both exist because Upstash
# rotates them; the receiver accepts either.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Provisioned in Stage 1, first read in Stage 2 (per-league cache, spec §2.2).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional locally; set in production.
SENTRY_DSN=

# Only used by scripts/schedule-players-sync.mjs.
API_BASE_URL=https://fantasyguru-api.fly.dev
