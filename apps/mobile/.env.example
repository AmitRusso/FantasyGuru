# Copy to .env for local development. Never commit the filled-in version.

# `EXPO_PUBLIC_*` vars are inlined into the client bundle at build time by Metro -- this is
# Expo's supported mechanism for a client-visible config value, not a secret. Defaults to the
# deployed Fly service (see apps/mobile/src/api/client.ts) when unset; override to point the
# app at a local API instance during development.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
