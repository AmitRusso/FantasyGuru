# Keep the workspace strict about phantom dependencies. packages/rules must stay
# dependency-free (build-plan.md S1), and hoisting is how that silently stops being true.
hoist=false
strict-peer-dependencies=false
auto-install-peers=true

# pnpm re-runs `pnpm install` before `exec`/`run`, which fails in shells where pnpm is only
# reachable through corepack. Contributors with pnpm on PATH are unaffected either way.
verify-deps-before-run=false
